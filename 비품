                                <button onclick="changeStatus(${item.id}, '대기중')" class="px-2.5 py-1 rounded-lg text-xs font-semibold ${item.status === '대기중' ? 'bg-amber-500 text-white' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-100'}">대기중</button>
                                <button onclick="changeStatus(${item.id}, '주문완료')" class="px-2.5 py-1 rounded-lg text-xs font-semibold ${item.status === '주문완료' ? 'bg-blue-600 text-white' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-100'}">🚚 주문완료</button>
                                <button onclick="changeStatus(${item.id}, '비치완료')" class="px-2.5 py-1 rounded-lg text-xs font-semibold ${item.status === '비치완료' ? 'bg-emerald-600 text-white' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-100'}">✅ 비치완료</button>
                                <button onclick="changeStatus(${item.id}, '보류/품절')" class="px-2.5 py-1 rounded-lg text-xs font-semibold ${item.status === '보류/품절' ? 'bg-slate-700 text-white' : 'bg-white border border-slate-200 text-slate-600 hover:bg-slate-100'}">보류</button>
                            </div>
                            <div class="flex items-center gap-1.5">
                                <input type="text" placeholder="담당자 한줄 안내 (예: 목요일 도착)" value="${item.adminMemo}" onchange="updateAdminMemo(${item.id}, this.value)" class="text-xs px-2.5 py-1 rounded-lg border border-slate-300 bg-white flex-1 sm:w-48 focus:outline-none focus:border-indigo-500">
                                <button onclick="deleteItem(${item.id})" class="text-xs text-rose-500 hover:bg-rose-50 px-2 py-1 rounded-lg transition" title="삭제">
                                    <i class="fa-regular fa-trash-can"></i>
                                </button>
                            </div>
                        </div>
                    ` : ''}
                </div>
                `;
            }).join('');
        }

        // 초기 실행
        window.onload = function () {
            renderRequests();
        };
    </script>
</body>
</html>
