        // PIN 입력 확인 처리
        function handlePinSubmit(e) {
            e.preventDefault();
            const val = document.getElementById('pinInput').value.trim();

            if (isChangingPin) {
                if (val.length < 2) {
                    const err = document.getElementById('pinErrorMsg');
                    err.textContent = '2자리 이상 입력해 주세요.';
                    err.classList.remove('hidden');
                    return;
                }
                adminPin = val;
                closePinModal();
                showToast(`🔑 담당자 비밀번호가 '${adminPin}'(으)로 변경되었습니다!`);
                return;
            }

            if (val === adminPin) {
                closePinModal();
                setRoleMode(true);
            } else {
                const err = document.getElementById('pinErrorMsg');
                err.textContent = '비밀번호가 일치하지 않습니다.';
