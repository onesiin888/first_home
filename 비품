        // 대기중인 품목 클립보드 일괄 복사 (엑셀/메신저 붙여넣기용)
        function copyPendingLinks() {
            const pending = requests.filter(r => r.status === '대기중');
            if (pending.length === 0) {
                showToast('현재 접수 대기 중인 품목이 없습니다.');
                return;
            }
            const lines = pending.map((r, idx) =>
                `${idx + 1}. [${r.category}] ${r.name} (${r.qty}) - 공감 ${r.likes}명\n   링크: ${r.url || '없음'}`
            ).join('\n\n');

            const textArea = document.createElement('textarea');
            textArea.value = `[탕비실/비품 구매 대기 목록 - 총 ${pending.length}건]\n\n` + lines;
            document.body.appendChild(textArea);
            textArea.select();
            document.execCommand('copy');
            document.body.removeChild(textArea);

            showToast(`대기 중인 ${pending.length}건의 품목과 링크가 복사되었습니다! (엑셀/메신저에 붙여넣기 가능)`);
        }

