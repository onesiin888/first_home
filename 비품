            selectCategory(cat);
            document.getElementById('itemName').value = name;
            document.getElementById('itemMemo').value = memo;
            document.getElementById('itemUrl').focus();
            showToast(`'${name}' 기본 정보가 입력되었습니다. 구매 링크만 붙여넣어 주세요!`);
        }

        // URL 입력 시 쇼핑몰 도메인 자동 인식 배지
        function detectMallDomain(url) {
            const preview = document.getElementById('domainPreview');
            if (!url) {
                preview.classList.add('hidden');
                return '';
            }
            let mall = '외부 구매처';
            if (url.includes('coupang.com')) mall = '🚀 쿠팡 링크 인식됨';
            else if (url.includes('naver.com')) mall = '🟢 네이버쇼핑 인식됨';
            else if (url.includes('gmarket.co.kr') || url.includes('auction.co.kr')) mall = '🛒 지마켓/옥션 인식됨';
            else if (url.includes('11st.co.kr')) mall = '📦 11번가 인식됨';
            else if (url.includes('kurly.com')) mall = '💜 컬리 인식됨';
            else mall = '🔗 구매 링크 확인됨';

            preview.textContent = mall;
            preview.classList.remove('hidden');
            return mall.replace(/^[^\s]+\s/, '').replace(' 인식됨', '');
        }

        // 새 신청 등록
        function handleAddRequest(e) {
            e.preventDefault();
            const category = document.getElementById('categoryInput').value;
            const name = document.getElementById('itemName').value.trim();
            const qty = document.getElementById('itemQty').value.trim() || '1개';
            const url = document.getElementById('itemUrl').value.trim();
            const requester = document.getElementById('requester').value.trim() || '익명';
            const memo = document.getElementById('itemMemo').value.trim();
            const urgent = document.getElementById('isUrgent').checked;

            if (!name) return;

            let mallName = '링크 없음';
            if (url) {
                if (url.includes('coupang')) mallName = '쿠팡 링크';
                else if (url.includes('naver')) mallName = '네이버쇼핑';
                else mallName = '구매 링크';
            }

            const newItem = {
                id: Date.now(),
                category,
                name,
                qty,
                url,
                mallName,
                requester,
                memo: memo || '신청합니다!',
                urgent,
                likes: 1,
                likedByMe: true,
                status: '대기중',
                adminMemo: '',
                createdAt: '방금 전',
                timestamp: Date.now()
            };

            requests.unshift(newItem);

            // 폼 초기화
            document.getElementById('itemName').value = '';
            document.getElementById('itemQty').value = '1개(박스)';
            document.getElementById('itemUrl').value = '';
            document.getElementById('itemMemo').value = '';
            document.getElementById('isUrgent').checked = false;
            document.getElementById('domainPreview').classList.add('hidden');

            renderRequests();
            showToast('신청함에 등록되었습니다! 👍');
        }

        // 나도 원해요(공감) 토글
        function toggleLike(id) {
            const item = requests.find(r => r.id === id);
            if (!item) return;

            if (item.likedByMe) {
                item.likes--;
                item.likedByMe = false;
            } else {
                item.likes++;
                item.likedByMe = true;
                showToast(`'${item.name}'에 공감(+1)을 눌렀습니다!`);
            }
            renderRequests();
        }

        // 담당자 상태 변경
        function changeStatus(id, newStatus) {
            const item = requests.find(r => r.id === id);
            if (!item) return;
            item.status = newStatus;
            renderRequests();
            showToast(`상태가 [${newStatus}](으)로 변경되었습니다.`);
        }

        // 담당자 코멘트 업데이트
        function updateAdminMemo(id, val) {
